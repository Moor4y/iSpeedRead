{
  "name": "ispeedread",
  "version": "1.0.0",
  "description": "Laptop library server for iSpeedRead",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "dev:client": "npm run dev --prefix client",
    "build": "tsc",
    "build:client": "npm run build --prefix client",
    "start": "node dist/server/index.js",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.5",
    "epub2": "^3.0.2",
    "express": "^5.1.0",
    "multer": "^1.4.5-lts.2",
    "pdf-parse": "^1.1.1",
    "sbd": "^1.0.19",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.3",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
